# Plethora Official Marketing Website — Environment Configuration
# Copy this file to .env.local for local development or configure in Vercel Project Settings.

# Public canonical site URL (used for metadata, Open Graph, canonical links, sitemap.xml, and robots.txt)
# Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL="https://plethoraqbs.co.za"

# Public approved contact email displayed in the footer and contact page
NEXT_PUBLIC_CONTACT_EMAIL="info@plethoraqbs.co.za"

# Optional: Public customer sign-in URL. Leave empty to omit the sign-in link in navigation.
NEXT_PUBLIC_APP_LOGIN_URL=""

# -----------------------------------------------------------------------------
# EMAIL SIGNUP & DEMO ENQUIRY BACKEND INTEGRATION (SERVER-ONLY)
# Never prefix these variables with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------

# Storage / Persistence Mode:
# - "file" (default fallback for local development/self-hosted verification; stores sanitised records in data/submissions/)
# - "webhook" (forwards submissions to a configured CRM/automation webhook URL)
# - "resend" (sends transactional notification / stores audience contact via Resend API)
PLETHORA_SUBMISSION_PROVIDER="file"

# Optional custom directory for local JSONL persistence (defaults to ./data/submissions, or /tmp/plethora-submissions on serverless read-only filesystems if no remote provider is configured)
PLETHORA_STORAGE_DIR=""

# Resend API Configuration (Required when PLETHORA_SUBMISSION_PROVIDER="resend")
RESEND_API_KEY="re_placeholder_your_resend_api_key"
RESEND_FROM_EMAIL="Plethora Website <notifications@plethoraqbs.co.za>"
RESEND_TO_EMAIL="info@plethoraqbs.co.za"
RESEND_AUDIENCE_ID="aud_placeholder_marketing_list_id"

# Webhook / CRM Integration (Required when PLETHORA_SUBMISSION_PROVIDER="webhook")
SUBMISSION_WEBHOOK_URL="https://example.com/api/webhooks/plethora"
SUBMISSION_WEBHOOK_SECRET="whsec_placeholder_secret"

# -----------------------------------------------------------------------------
# WEBSITE & COMMUNICATIONS ADMIN CONSOLE (/admin)
# -----------------------------------------------------------------------------
# Password required to sign in at /admin (defaults to "plethora-admin-2026" in local dev if unset)
PLETHORA_ADMIN_PASSWORD="plethora-admin-2026"

# HMAC-SHA256 signing secret for HttpOnly admin session cookies
PLETHORA_ADMIN_SECRET="replace_with_a_long_random_signing_secret_in_production"

